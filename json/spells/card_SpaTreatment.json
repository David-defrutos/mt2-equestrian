                {
                    "status": "armor",
                    "count": 10
                }
            ]
        },
        {
            "id": "SpaHeal1",
            "name": "CardEffectHeal",
            "target_mode": "last_targeted_characters",
            "target_team": "both",
            "param_int": 3
        },
        {
            "id": "SpaHeal2",
            "name": "CardEffectHeal",
            "target_mode": "last_targeted_characters",
            "target_team": "both",
            "param_int": 3
        },
        {
            "id": "SpaHeal3",
            "name": "CardEffectHeal",
            "target_mode": "last_targeted_characters",
            "target_team": "both",
            "param_int": 3
        }
    ],
    "sprites": [
        {
            "id": "SpaTreatmentArt",
            "path": "textures/SpaTreatmentArt.png"
        }
    ],
    "game_objects": [
        {
            "id": "SpaTreatmentArt",
            "type": "card_art",
            "extensions": {
                "card_art": {
                    "sprite": "@SpaTreatmentArt"
                }
            }
        }
    ]
