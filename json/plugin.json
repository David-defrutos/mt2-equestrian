{
    "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/refs/heads/main/schemas/base.json",
    "traits": [
        {
            "id": "Consume",
            "name": "CardTraitExhaustState"
        }
    ],
    "additional_tooltips": [
        {
            "id": "SocialTooltip",
            "titles": {
                "english": "Social"
            },
            "descriptions": {
                "english": "<b>Social</b> units add +1[size] to the floor they stand on."
            },
            "style": "keyword",
            "allow_secondary_placement": true
        }
    ],
    "card_pools": [
        {
            "id": "TrashPandaPool",
            "cards": [
                "@SpawnTrashPanda"
            ]
        },
        {
            "id": "YoLoPool",
            "cards": [
                "@SpawnYoLo"
            ]
        },
        {
            "id": "FinchyPool",
            "cards": [
                "@SpawnFinchy"
            ]
        },
        {
            "id": "CrunchieMunchiePool",
            "cards": [
                "@SpawnCrunchieMunchie"
            ]
        },
        {
            "id": "FilliesPool",
            "cards": [
                "@SpawnYoLo",
                "@SpawnFinchy",
                "@SpawnCrunchieMunchie"
            ]
        },
        {
            "id": "MareaLeeMentorIIIPool",
            "cards": [
                "@SpawnMistyStep",
                "@SpawnSnackasmacky",
                "@SpawnSqueakyBooBoo",
                "@SpawnStaticJoy"
            ]
        },
        {
            "id": "NightTerrorsPool",
            "cards": [
                "@NightTerrors"
            ]
        },
        {
            "id": "JunkFoodPool",
            "cards": [
                "@SpawnYoLo",
                "@SpawnFinchy",
                "@SpawnCrunchieMunchie",
                "@SpawnMistyStep",
                "@SpawnSnackasmacky",
                "@SpawnSqueakyBooBoo",
                "@SpawnStaticJoy",
                "@SpawnMareYouKnow",
                "@SpawnPreenySnuggle"
            ]
        }
    ],
    "upgrades": [
        {
            "id": "GradstoneUpgrade",
            "titles": {
                "english": "Gradstone"
            },
            "descriptions": {
                "english": "+10[attack], +10[health], 0[ember] and <b>Social</b>."
            },
            "bonus_hp": 10,
            "bonus_damage": 10,
            "cost_reduction": 99,
            "trigger_upgrades": [
                "@SocialDeath",
                "@SocialSpawn"
            ]
        }
    ],
    "effects": [
        {
            "id": "SocialAddCapacity",
            "name": "CardEffectAdjustRoomCapacity",
            "target_mode": "room",
            "target_team": "monsters",
            "param_int": 1
        },
        {
            "id": "SocialRemoveCapacity",
            "name": "CardEffectAdjustRoomCapacity",
            "target_mode": "room",
            "target_team": "monsters",
            "param_int": -1
        }
    ],
    "character_triggers": [
        {
            "id": "SocialSpawn",
            "trigger": "on_spawn",
            "descriptions": {
                "english": "<b>Social</b>: +1[size] to this floor."
            },
            "effects": [
                "@SocialAddCapacity"
            ]
        },
        {
            "id": "SocialDeath",
            "trigger": "on_death",
            "descriptions": {
                "english": "<b>Social</b>: -1[size] to this floor."
            },
            "hide_visual_and_ignore_silence": true,
            "effects": [
                "@SocialRemoveCapacity"
            ]
        }
    ],
    "upgrade_masks": [
        {
            "id": "MonsterOnlyFilter",
            "card_type": "monster"
        },
        {
            "id": "PonyOnlyFilter",
            "card_type": "monster",
            "required_subtypes": [
                "@Sub_Pony"
            ]
        }
    ]
}