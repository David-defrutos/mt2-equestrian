<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>mt2_equestrian.Plugin</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="MonsterTrain2.Api" Version="4.5.21908879" />
    <PackageReference Include="TrainworksReloaded.Base" Version="0.7.8" />
  </ItemGroup>

  <!-- Sin reglas de copia de json/ ni textures/: cuelgan de la raiz de la carpeta
       del plugin, no de src/. El build solo produce el DLL.
       Sin referencia a Conductor: no se escribe C# propio. La dependencia de
       Conductor sigue en manifest.json porque los JSON usan su tracked value
       NumUnitsInTargetRoom. -->
</Project>
